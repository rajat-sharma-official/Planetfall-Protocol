{"inkVersion":21,"root":[["\n",{"->":"start"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"NPC.kase"},{"f()":"register_npc"},"pop","/ev","\n","ev",{"VAR?":"met_child"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"hub_b"},{"->":"start.11"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"hub_a"},{"->":"start.11"},null]}],"nop","\n",{"#f":1}],"hub_a":[["^Kase: Don’t waste my time.","\n","^Kase: I’m working.","\n","ev","str","^sorry","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["end","\n",{"#f":5}],"c-1":["^ ","end","\n",{"#f":5}],"c-2":["^ ","end","\n",{"#f":5}],"c-3":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"hub_b":[["^Kase sits apart from the main path, surrounded by scraps of notes and charcoal sketches of old mechanisms.","\n","^He doesn’t greet you—he just pauses mid-writing, waiting to see if you’re worth the interruption","\n","ev","str","^Leave.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Who are you?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^What caused the collapse?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^What do you fear the scholars will do?","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["^ ","end","\n",{"#f":5}],"c-1":["^ ",{"->":"b1"},"\n",{"#f":5}],"c-2":["^ ",{"->":"b2"},"\n",{"#f":5}],"c-3":["^ ",{"->":"b3"},"\n",{"#f":5}]}],{"#f":1}],"b1":["^Kase: Kase. Researcher.","\n","^I write down the parts everyone avoids: cause and consequence.","\n","^Solace survives because we learn. Not because we hope.","\n","^Hope is for people with safety.","\n","end",{"#f":1}],"b2":["^Kase: One buried system fed the whole “advanced” age.","\n","^Power, distribution, regulation—everything ran through it.","\n","^Then it failed, and the world’s tech died together.","\n","^Not “slowly.” Not “over time.” Together.","\n","^Like a body when the heart stops.","\n","end",{"#f":1}],"b3