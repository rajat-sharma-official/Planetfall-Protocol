{"inkVersion":21,"root":[["\n",{"->":"start"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"NPC.eira"},{"f()":"register_npc"},"pop","/ev","\n","ev",{"VAR?":"met_child"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"hub_b"},{"->":"start.11"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"hub_a"},{"->":"start.11"},null]}],"nop","\n",{"#f":1}],"hub_a":[["^Eira: Not today.","\n","^Eira: I’m busy. Move.","\n","ev","str","^sorry","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["end","\n",{"#f":5}],"c-1":["^ ","end","\n",{"#f":5}],"c-2":["^ ","end","\n",{"#f":5}],"c-3":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"hub_b":["^You find Eira near medical herbs, her hands stained with crushed leaves.","\n","^She glances up just once—long enough to measure how tired you look—then motions you closer.","\n",{"->":"b_menu"},{"#f":1}],"b_menu":[["ev","str","^Leave.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Who are you, really?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Can you help if I’m hurt?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^What is Solace Outpost trying to be?","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["^ ","end","\n",{"#f":5}],"c-1":["^ ",{"->":"b1"},"\n",{"#f":5}],"c-2":["^ ",{"->":"b2"},"\n",{"#f":5}],"c-3":["^ ",{"->":"b3"},"\n",{"#f":5}]}],{"#f":1}],"b1":["^Eira: I’m Eira. I patch up what the Riftlands breaks.","\n","^Eira: I wasn’t raised for this. Nobody is.","\n","^Eira: But when your home is far from help, you become the help.","\n","^I stay calm so other people can keep moving.","\n",{"->":"b_menu"},{"#f":1}],"b2":["^Eira: Yes. Sit down and tell the truth—where it hurts, how bad, how long.","\n","^Eira: The Riftlands don’t kill you with one dramatic blow.","\n","^They take you piece by piece—cold, hunger, bad footing, exhaustion.","\n","^Come early. Healing works best before you’re desperate.","\n",{"->":"b_menu"},{"#f":1}],"b3":["^Eira: Solace is a promise.","\n","^Not that life will be easy—just that we’ll stop pretending the old world is coming back.","\n","^The scholars want restoration. The scrappers want profit. We want survival without repeating the same mistake.","\n","^And I want the colonies to stop acting like strangers forever.","\n",{"->":"b_menu"},{"#f":1}],"register_npc":[{"temp=":"who"},["ev",{"VAR?":"met_npcs"},{"VAR?":"who"},"?","/ev",{"->":".^.b","c":true},{"b":["\n","ev",false,"/ev","~ret",{"->":".^.^.^.3"},null]}],[{"->":".^.b"},{"b":["\n","ev",{"VAR?":"met_npcs"},{"VAR?":"who"},"+",{"VAR=":"met_npcs","re":true},"/ev","ev",{"VAR?":"npcs_talked"},1,"+",{"VAR=":"npcs_talked","re":true},"/ev","ev",true,"/ev","~ret",{"->":".^.^.^.3"},null]}],"nop","\n",{"#f":1}],"global decl":["ev",{"list":{},"origins":["NPC"]},{"VAR=":"NPC"},{"list":{}},{"VAR=":"met_npcs"},0,{"VAR=":"npcs_talked"},0,{"VAR=":"Dialogue_scrap"},false,{"VAR=":"met_child"},false,{"VAR=":"maerlon_gave_scrap"},false,{"VAR=":"drayk_gave_scrap"},false,{"VAR=":"spoke_to_marrek"},0,{"VAR=":"danriel_block_level"},false,{"VAR=":"stolen_scrap"},"/ev","end",null],"#f":1}],"listDefs":{"NPC":{"maerlon":1,"child":2,"marrek":3,"eira":4,"drayk":5,"kase":6,"erixa":7,"sanya":8,"julisa":9,"harvel":10,"camla":11,"nayli":12,"danriel":13,"emex":14}}}