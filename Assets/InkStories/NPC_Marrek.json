{"inkVersion":21,"root":[["\n",{"->":"start"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"start":["ev",{"VAR?":"NPC.marrek"},{"f()":"register_npc"},"pop","/ev","\n","ev",{"VAR?":"npcs_talked"},2,">","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"normal_hub"},{"->":"start.13"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"hostile_hub"},{"->":"start.13"},null]}],"nop","\n",{"#f":1}],"hostile_hub":[["^Marrek: Not another drifter.","\n","^Marrek: If you want comfort, go back down the mountain.","\n","ev","str","^Sorry.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^...","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["^ ","end","\n",{"#f":5}],"c-1":["^ ","end","\n",{"#f":5}],"c-2":["^ ","end","\n",{"#f":5}],"c-3":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"normal_hub":["^You step into the center of <b>Solace Outpost</b> where a rough circle of stone marks their meeting ground.","\n","^Marrek is already watching you, arms folded, like he’s been expecting you to speak first.","\n","^Marrek: You’ve been walking this planet long enough to learn one thing—","\n","^Marrek: nothing here is free. Not answers. Not help. Not trust.","\n","^Marrek: Speak.","\n",{"->":"normal_menu"},{"#f":1}],"normal_menu":[["ev","str","^Leave.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^What do the Revivalists stand for?","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^What happened to Aurelia’s tech?","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Where should I go next?","/str","/ev",{"*":".^.c-3","flg":4},{"c-0":["^ ","end","\n",{"#f":5}],"c-1":["^ ",{"->":"normal_belief"},"\n",{"#f":5}],"c-2":["^ ",{"->":"normal_collapse"},"\n",{"#f":5}],"c-3":["^ ",{"->":"normal_next"},"\n",{"#f":5}]}],{"#f":1}],"normal_belief":["^Marrek: We rebuild with what the land can spare.","\n","^Marrek: No chasing the <b>old machine</b> like it’s a god.","\n","^Marrek: We live. We grow. We bury our dead and keep